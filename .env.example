# ==============================================================================
# Scraper Studio Configuration Template (.env.example)
# Copy this to .env and fill in your OPENAI_API_KEY
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenAI Authentication (REQUIRED)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Custom OpenAI Base URL / Org / Project
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# ------------------------------------------------------------------------------
# Model Configuration
# ------------------------------------------------------------------------------
OPENAI_MODEL=gpt-5.6-luna
OPENAI_RECON_MODEL=gpt-5.6-luna
OPENAI_CODEGEN_MODEL=gpt-5.6-luna
OPENAI_TEMPERATURE=1.0

# ------------------------------------------------------------------------------
# Playwright MCP Server Configuration
# ------------------------------------------------------------------------------
MCP_SERVER_URL=http://localhost:8931

# ------------------------------------------------------------------------------
# Site Analyzer Service Configuration
# ------------------------------------------------------------------------------
SITE_ANALYZER_URL=https://ss-api-1.mobiusservices.co.in/analyze
SITE_ANALYZER_TIMEOUT=35.0
# Set to false to allow self-signed / incomplete corporate intermediate certificates
SITE_ANALYZER_VERIFY_SSL=false
# Optional custom CA bundle path if using corporate SSL interception/gateway:
# SITE_ANALYZER_CA_BUNDLE=C:\path\to\corporate_root_ca.crt
